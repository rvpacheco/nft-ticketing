generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  PENDING // created by the promoter, buyer hasn't opened the magic link yet
  ASSIGNED // buyer onboarded, wallet created
  MINTED // cNFT minted to the buyer's wallet
  USED // redeemed at the door
  REVOKED // revoked by reassignment or another reason
}

enum RedemptionResult {
  GRANTED
  ALREADY_USED
  EXPIRED_QR
  INVALID_SIGNATURE
  OWNERSHIP_MISMATCH
  TICKET_NOT_FOUND
  NOT_AUTHORIZED // the scanner is not staff of the promoter who owns the event
}

model Promoter {
  id          String   @id @default(cuid())
  privyUserId String   @unique
  email       String   @unique
  name        String?
  createdAt   DateTime @default(now())
  events      Event[]
  staff       Staff[]
}

// Door staff allowed to scan a promoter's events.
// They open /scan with a Privy login for the email registered here.
model Staff {
  id         String   @id @default(cuid())
  promoterId String
  promoter   Promoter @relation(fields: [promoterId], references: [id])
  email      String
  name       String?
  createdAt  DateTime @default(now())

  @@unique([promoterId, email])
  @@index([email])
}

model Event {
  id         String   @id @default(cuid())
  promoterId String
  promoter   Promoter @relation(fields: [promoterId], references: [id])
  name       String
  venue      String
  startsAt   DateTime
  capacity   Int
  createdAt  DateTime @default(now())
  tickets    Ticket[]
}

model Ticket {
  id            String       @id @default(cuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  buyerEmail    String
  walletAddress String? // set during onboarding (phase 2)
  nftAssetId    String? // set when minting (phase 3)
  status        TicketStatus @default(PENDING)
  tier          String       @default("general")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  redemptions   RedemptionLog[]
  reassignments ReassignmentLog[]

  @@index([eventId, status])
  @@index([buyerEmail])
}

model RedemptionLog {
  id        String           @id @default(cuid())
  ticketId  String
  ticket    Ticket           @relation(fields: [ticketId], references: [id])
  scannerId String // identifier of the device/staff that scanned
  result    RedemptionResult
  // true if the on-chain ownership check was skipped (timeout/offline)
  chainCheckSkipped Boolean  @default(false)
  createdAt DateTime         @default(now())

  @@index([ticketId])
}

model ReassignmentLog {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
  fromEmail     String
  toEmail       String
  oldNftAssetId String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([ticketId])
}
