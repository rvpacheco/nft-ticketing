# --- Base de datos (Neon) ---
# 1. Crea una cuenta gratis en https://neon.tech
# 2. Crea un proyecto (region cercana), copia la "Connection string" (pooled)
# 3. Pegala aqui en tu .env real
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Privy (auth + embedded wallets) ---
# 1. Crea una cuenta en https://privy.io y una app nueva
# 2. En el dashboard de la app: copia el App ID (es publico, va con NEXT_PUBLIC_)
#    y el App Secret (privado, solo server)
# 3. En Login Methods activa "Email"; en Embedded Wallets activa Solana
NEXT_PUBLIC_PRIVY_APP_ID="clxxxxxxxxxxxx"
PRIVY_APP_SECRET="privy-app-secret"

# --- Helius (RPC Solana + DAS API para leer cNFTs) ---
# 1. Crea una cuenta gratis en https://helius.dev
# 2. Copia tu API key del dashboard
HELIUS_API_KEY="tu-api-key"
# RPC de devnet con tu key (Helius arma la URL asi):
SOLANA_RPC_URL="https://devnet.helius-rpc.com/?api-key=tu-api-key"

# --- Keypair del servidor (mintea los tickets, autoridad del Merkle tree) ---
# Lo genera scripts/generate-keypair.ts — NO lo compartas ni lo subas a git.
# Es el array JSON de la secret key, ej: [12,34,56,...]
SERVER_WALLET_SECRET_KEY="[]"

# Direccion del Merkle tree creado con scripts/create-tree.ts (setup unico)
MERKLE_TREE_ADDRESS="..."
# URL publica de la app (para las URIs de metadata de los NFTs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
